{
    "name": "tokk",
    "version": "0.1.0",
    "description": "A sound-event engine that lets an app react to short sounds such as a clap, a knock or a whistle, in the browser and in Node.",
    "keywords": [
        "sound",
        "audio",
        "microphone",
        "sound control",
        "clap",
        "whistle",
        "sound detection",
        "audio events",
        "web audio",
        "tokk",
        "mcp"
    ],
    "homepage": "https://github.com/subniin/tokk#readme",
    "bugs": {
        "url": "https://github.com/subniin/tokk/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/subniin/tokk.git"
    },
    "author": "subniin",
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "main": "./dist/tokk.js",
    "types": "./dist/types/web/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/web/index.d.ts",
            "browser": "./dist/tokk.js",
            "import": "./dist/tokk.js"
        },
        "./node": {
            "types": "./dist/types/node/index.d.ts",
            "import": "./dist/node.js"
        }
    },
    "bin": {
        "tokk-mcp": "./dist/mcp.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "directories": {
        "doc": "docs"
    },
    "type": "module",
    "devDependencies": {
        "@fast-check/vitest": "^0.5.0",
        "@modelcontextprotocol/sdk": "1.32.2",
        "@playwright/test": "1.65.0",
        "@types/node": "^26.6.6",
        "esbuild": "0.28.2",
        "fast-check": "^4.10.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.1.1",
        "zod": "4.6.7"
    },
    "scripts": {
        "build": "tsx scripts/build.ts",
        "prepack": "npm run build",
        "dev": "tsx scripts/build.ts --dev",
        "test": "vitest run",
        "test:quick": "vitest run --reporter dot",
        "test:web": "playwright test",
        "check:public-api": "tsx scripts/check-public-api.ts",
        "build:site": "tsx scripts/build-site.ts",
        "count:wiring": "tsx scripts/count-wiring.ts",
        "pbt:quick": "tsx scripts/pbt-quick.ts",
        "score": "tsx scripts/score.ts",
        "mcp": "tsx tools/mcp-ears/server.ts",
        "sounds:rebuild": "tsx scripts/sounds-rebuild.ts",
        "synth:fixtures": "tsx scripts/make-synth-fixtures.ts",
        "corpus-score": "tsx scripts/corpus-score.ts"
    }
}
