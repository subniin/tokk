{
  "version": "v1",
  "hooks": [
    {
      "name": "corpus-score",
      "description": "Score the best available labelled set when a file under core/ is saved.",
      "trigger": "PostFileSave",
      "matcher": "(^|[\\\\/])core[\\\\/]",
      "action": {
        "type": "command",
        "command": "npm run corpus-score"
      },
      "timeout": 30,
      "enabled": true
    }
  ]
}